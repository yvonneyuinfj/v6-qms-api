<select id="searchQmsAuditPlan" parameterType="java.util.Map" resultMap="QmsAuditPlanDTOMap">
    select
    <include refid="commonColums"/>
    from QMS_AUDIT_PLAN t1
    <where>
		<if test="bean != null">
			<choose>
				<when test="keyWords != null and keyWords != '' ">
					<include refid="commonWhereOr"/>
				</when>
				<otherwise>
					<include refid="commonWhereAnd"/>
				</otherwise>
			</choose>
		</if>
		<include refid="defaultWhereAnd"/>
    </where>
    order by t1.tree_sorts asc
</select>
